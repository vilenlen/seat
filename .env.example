# ── Supabase（登录 + 数据库）────────────────────────────────────
# 控制台 → Project Settings → API 中获取
SUPABASE_URL=
# 前端用（可暴露给浏览器）
SUPABASE_ANON_KEY=
# 仅后端用（绝不可暴露，勿放到前端/客户端）
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI（托管推理）───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Lemon Squeezy（订阅支付）────────────────────────────────────
# Settings → API 中获取 API Key；Store 页 URL 中获取 store id
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Webhooks 页面设置的签名密钥
LEMONSQUEEZY_WEBHOOK_SECRET=
# 产品 Variant id（Products → 对应 variant 页 URL 中的数字）
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_YEARLY=

# ── 套餐额度（token 数，可选）───────────────────────────────────
# FREE_QUOTA_TOKENS=20000
# PRO_QUOTA_TOKENS=2000000
